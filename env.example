# Neon pooled connection string (application traffic).
# `neon env pull` writes DATABASE_URL into .env.local for local development.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon direct/non-pooled connection string. Used for DDL migrations only.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Random secret for signing HS256 JWT session tokens (32+ random bytes).
JWT_SECRET=change_me_to_random_secret

# Server bind port. Docker defaults to 7860; Render sets 10000.
PORT=7860
